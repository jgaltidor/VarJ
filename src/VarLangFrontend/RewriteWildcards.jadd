import txtreplace.ReplaceInfo;
import java.util.Collections;
import java.util.Set;

aspect RewriteWildcard
{
	/** Output stream to the rewrite specification file */
	public static java.io.PrintStream ASTNode.rewriteOut = null;
	
	
	public void ASTNode.rewriteAllVarTypes() {
    for(int i = 0; i < getNumChild(); i++) {
    	getChild(i).rewriteAllVarTypes();
    }
	}
	
	public void Program.rewriteAllVarTypes() {
		for(int i = 0; i < getNumCompilationUnit(); i++) {
			CompilationUnit unit = getCompilationUnit(i);
			if(unit.fromSource()) {
				unit.rewriteAllVarTypes();
				// write fake replacement info to ensure this
				// unit's source file is copied to the new
				// directory even if no types in this unit
				// required an update
				unit.writeFakeReplaceInfo();
			}
		}
	}

	public void InfluenceNode.rewriteAllVarTypes() {
		if(isRewritable()) {
			writeToWildcards();
			super.rewriteAllVarTypes();
		}
	}

	public void Program.writeFakeReplaceInfo() {
		for(int i = 0; i < getNumCompilationUnit(); i++) {
			CompilationUnit unit = getCompilationUnit(i);
			if(unit.fromSource())
				unit.writeFakeReplaceInfo();
		}
	}

	public void CompilationUnit.writeFakeReplaceInfo() {
		ReplaceInfo fakeReplacement = new ReplaceInfo(
			sourceFile(), -1, -1, -1, -1, " ", " ");
		LOG.log(INFO, "fake rewrite: " + fakeReplacement);
		rewriteOut.println(fakeReplacement);
	}


	public void TypeDecl.rewriteMemberTypes() {
		for(InfluenceNode node : affectedNodes()) {
			if(node.isRewritable()) {
				((ASTNode) node).writeToWildcards();
			}
		}
	}

	/** Should be dispatched on the node that is being rewritten */
	public void ASTNode.writeWildcardReplaceInfo(String oldAccess, String newAccess, int colOffset)
	{
		if(oldAccess.equals(newAccess))
			return;
		ReplaceInfo replacement = new ReplaceInfo(
			sourceFile(),
			getLine(getStart()),
			getColumn(getStart()),
			getLine(getEnd()),
			colOffset + getColumn(getEnd()),
			oldAccess,
			newAccess);
		LOG.log(INFO, "rewrite: " + replacement);
		rewriteOut.println(replacement);
	}
	
	public void ASTNode.writeWildcardReplaceInfo(String oldAccess, String newAccess) {
		writeWildcardReplaceInfo(oldAccess, newAccess, 0);
	}
	
	syn lazy boolean InfluenceNode.isRewritable() circular [true] {
		if(!rewriteCheck()) {
			return false;
		}
		for(InfluenceNode inode : reachableINodes()) {
			if(!inode.rewriteCheck()) {
				return false;
			}
		}
		return true;
	}


	syn lazy boolean InfluenceNode.rewriteCheck();
	
	eq VariableDeclaration.rewriteCheck() = isFromSource();
	eq FieldDeclaration.rewriteCheck() = isFromSource();
	
	/** Checking if return type is a type variable
	  * because of overriding.
	  */
	eq MethodDecl.rewriteCheck() {
		TypeDecl typ = type();
		return (typ.isTypeVariable() || typ.containsMethodTypeVariable()) ?
			false : isFromSource();
	}

		
	/** Checking if param's type is a type variable
	  * because of overriding.
	  */
	eq ParameterDeclaration.rewriteCheck() {
		TypeDecl typ = type();
		return (typ.isTypeVariable() || typ.containsMethodTypeVariable()) ?
			false : isFromSource();
	}

	eq VariableArityParameterDeclaration.rewriteCheck() = false;

	/** Returns the set of InfluenceNodes that requires
	  * updating, if this node is updated
	  */
	syn lazy Set<InfluenceNode> TypeDecl.affectedNodes() {
		Set<InfluenceNode> nodes = ASTUtils.createSet();
		// collect affectsNodes appropriate members
		for (int j=0; j < getNumBodyDecl(); j++) {
			BodyDecl b = getBodyDecl(j);
			nodes.addAll(b.affectedNodes());
		}
		return nodes;
	}


	syn lazy Set<InfluenceNode> BodyDecl.affectedNodes() =
		Collections.emptySet();
	
	syn lazy Set<InfluenceNode> InfluenceNode.affectedNodes();
	
	/** Adding a "base method" for affectedNodes
	  * to interface InfluenceNode
	  */
	public static Set<InfluenceNode> ASTNode.affectedNodes(InfluenceNode thisNode)
	{
		Set<InfluenceNode> nodes = ASTUtils.singletonSet(thisNode);
		nodes.addAll(thisNode.reachableINodes());
		return nodes;
	}
	
	eq Variable.affectedNodes() = affectedNodes(this);

	eq MethodDecl.affectedNodes() {
		Set<InfluenceNode> nodes = ASTUtils.createSet();
		nodes.addAll(affectedNodes(this));
		for(int i = 0; i < getNumParameter(); i++) {
			nodes.addAll(getParameter(i).affectedNodes());
		}
		return nodes;
	}

	public void ASTNode.writeToWildcards() { }
	
	// need to determine criteria for selecting ASTNodes to rewrite
	
	public void FieldDeclaration.writeToWildcards() {
		Access type = getTypeAccess();
		String oldAccess = type.toString();
		String newAccess = type.wildString();
		type.writeWildcardReplaceInfo(oldAccess, newAccess);
	}


	public void VariableDeclaration.writeToWildcards() {
		Access type = getTypeAccess();
		String oldAccess = type.toString();
		String newAccess = type.wildString();
		type.writeWildcardReplaceInfo(oldAccess, newAccess);
	}


	public void ParameterDeclaration.writeToWildcards() {
		Access type = getTypeAccess();
		String oldAccess = type.toString();
		String newAccess = type.wildString();
		type.writeWildcardReplaceInfo(oldAccess, newAccess);
	}


	/** Only rewrites the return type of the method */
	public void MethodDecl.writeToWildcards() {
		Access returnType = getTypeAccess();
		String oldAccess = returnType.toString();
		String newAccess = returnType.wildString();
		returnType.writeWildcardReplaceInfo(oldAccess, newAccess);
	}


	/** Returns new type access to have wildcards based on
	  * inferred def-site variances.
	  */
	syn String Access.wildString() = toString();
	
	eq ArrayTypeAccess.wildString() {
		StringBuffer newAccess = new StringBuffer();
		newAccess.append(getAccess().wildString());
		newAccess.append("[]");
		return newAccess.toString();
	}

	eq ParTypeAccess.wildString() {
		if(isRaw()) {
			return toString();
		}
		StringBuffer newAccess = new StringBuffer();
		getTypeAccess().toString(newAccess);
		newAccess.append('<');
		// rewriting type arguments
		GenericTypeDecl gtd = (GenericTypeDecl) genericDecl();
		for(int i = 0; i < gtd.getNumTypeParameter(); i++) {
			Access oldArg = getTypeArgument(i);
			Value inferredDVar = gtd.computeVar(i);
			Value oldUVar;
			if(oldArg instanceof WildcardSuper) {
				oldUVar = CONTRAVARIANT;
			}
			else if(oldArg instanceof WildcardExtends) {
				oldUVar = COVARIANT;
			}
			else if(oldArg instanceof Wildcard) {
				oldUVar = BIVARIANT;
			}
			else {
				oldUVar = INVARIANT;
			}
			// inferred use-site annotation
			Value newUVar = inferredDVar.join(oldUVar);
			String typeActual = null;
			if(newUVar.equals(COVARIANT)) {
				if(oldUVar.equals(INVARIANT)) {
					typeActual = oldArg.wildString();
				}
				else if(oldUVar.equals(COVARIANT)) {
					typeActual = ((WildcardExtends) oldArg).getAccess().wildString();
				}
				// one of the above assignments must have been executed
				assert typeActual != null;
			}
			else {
				if(oldUVar.equals(CONTRAVARIANT)) {
					typeActual = ((WildcardSuper) oldArg).getAccess().toString();
				}
				else if(oldUVar.equals(INVARIANT)) {
					typeActual = oldArg.toString();
				}
				else {
					assert newUVar.equals(BIVARIANT);
				}
			}
			String newArg; // new type argument
			if(newUVar.equals(BIVARIANT))
				newArg = "?";
			else if(newUVar.equals(CONTRAVARIANT))
				newArg = "? super "   + typeActual;
			else if(newUVar.equals(COVARIANT))
				newArg = "? extends " + typeActual;
			else // newUVar.equals(INVARIANT)
				newArg = typeActual;
			// append delimeter if needed
			if(i > 0) {
				newAccess.append(", ");
			}
			newAccess.append(newArg);
		}
		newAccess.append('>');
		return newAccess.toString();
	}

	eq WildcardSuper.wildString() {
		StringBuffer newAccess = new StringBuffer();
		newAccess.append("? super ");
		newAccess.append(getAccess().wildString());
		return newAccess.toString();
	}

	eq WildcardExtends.wildString() {
		StringBuffer newAccess = new StringBuffer();
		newAccess.append("? extends ");
		newAccess.append(getAccess().wildString());
		return newAccess.toString();
	}

	inh lazy boolean TypeDecl.isMethodTypeVariable();
	eq GenericMethodDecl.getTypeParameter(int i).isMethodTypeVariable() = true;
	eq GenericConstructorDecl.getTypeParameter(int i).isMethodTypeVariable() = true;
	eq Program.getChild().isMethodTypeVariable() = false;
	
		
	syn lazy boolean TypeDecl.containsMethodTypeVariable() = false;

	eq TypeVariable.containsMethodTypeVariable() = isMethodTypeVariable();

	eq ParTypeDecl.containsMethodTypeVariable() {
		for (int i = 0; i < getNumArgument(); i++) {
			if(getArgument(i).type().containsMethodTypeVariable())
				return true;
		}
		return false;
	}

	eq ArrayDecl.containsMethodTypeVariable() =
		componentType().containsMethodTypeVariable();

	eq WildcardExtendsType.containsMethodTypeVariable() =
		getAccess().type().containsMethodTypeVariable();

	eq WildcardSuperType.containsMethodTypeVariable() =
		getAccess().type().containsMethodTypeVariable();
}
