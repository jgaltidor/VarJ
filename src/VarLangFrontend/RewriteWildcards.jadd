import txtreplace.ReplaceInfo;
import java.util.Collections;
import java.util.Set;

aspect RewriteWildcard
{
	/** Output stream to the rewrite specification file */
	public static java.io.PrintStream ASTNode.rewriteOut = null;
	
	
	public void ASTNode.rewriteAllVarTypes() {
    for(int i = 0; i < getNumChild(); i++) {
    	getChild(i).rewriteAllVarTypes();
    }
	}
	
	public void Program.rewriteAllVarTypes() {
		for(int i = 0; i < getNumCompilationUnit(); i++) {
			CompilationUnit unit = getCompilationUnit(i);
			if(unit.fromSource()) {
				unit.rewriteAllVarTypes();
				// write fake replacement info to ensure this
				// unit's source file is copied to the new
				// directory even if no types in this unit
				// required an update
				unit.writeFakeReplaceInfo();
			}
		}
	}

	public void InfluenceNode.rewriteAllVarTypes() {
		if(willRewrite()) {
			writeToWildcards();
		}
		super.rewriteAllVarTypes();
	}
	
	
	syn boolean InfluenceNode.willRewrite() =
		isRewritable() && mayPromoteWildcard();

	public void Program.writeFakeReplaceInfo() {
		for(int i = 0; i < getNumCompilationUnit(); i++) {
			CompilationUnit unit = getCompilationUnit(i);
			if(unit.fromSource())
				unit.writeFakeReplaceInfo();
		}
	}

	public void CompilationUnit.writeFakeReplaceInfo() {
		ReplaceInfo fakeReplacement = new ReplaceInfo(
			sourceFile(), -1, -1, -1, -1, " ", " ");
		LOG.log(INFO, "fake rewrite: " + fakeReplacement);
		rewriteOut.println(fakeReplacement);
	}


	public void TypeDecl.rewriteMemberTypes() {
		for(InfluenceNode node : affectedNodes()) {
			if(node.isRewritable()) {
				((ASTNode) node).writeToWildcards();
			}
		}
	}

	/** Should be dispatched on the node that is being rewritten */
	public void ASTNode.writeWildcardReplaceInfo(String oldAccess, String newAccess, int colOffset)
	{
		if(oldAccess.equals(newAccess)) {
			return;
		}
		// ignoring nodes not generated from the parser
		// such as nodes generated from AST rewrites
		if(getStart() == 0 && getEnd() == 0) {
			LOG.log(INFO, "ignoring node with invalid source file location");
			return;
		}
		ReplaceInfo replacement = new ReplaceInfo(
			sourceFile(),
			getLine(getStart()),
			getColumn(getStart()),
			getLine(getEnd()),
			colOffset + getColumn(getEnd()),
			oldAccess,
			newAccess);
		LOG.log(INFO, "rewrite: " + replacement);
		rewriteOut.println(replacement);
	}
	
	public void ASTNode.writeWildcardReplaceInfo(String oldAccess, String newAccess) {
		writeWildcardReplaceInfo(oldAccess, newAccess, 0);
	}
	
	syn lazy boolean InfluenceNode.isRewritable() circular [true] {
		if(!rewriteCheck()) {
			return false;
		}
		for(InfluenceNode inode : reachableINodes()) {
			if(!inode.rewriteCheck()) {
				return false;
			}
		}
		return true;
	}


	syn lazy boolean InfluenceNode.rewriteCheck();
	
	eq VariableDeclaration.rewriteCheck() = isFromSource();
	
	eq FieldDeclaration.rewriteCheck() = isFromSource();
	
	/** Checking if return type is a type variable
	  * because of overriding.
	  */
	eq MethodDecl.rewriteCheck() {
		TypeDecl typ = type();
		return typ.isTypeVariable() ? false : isFromSource();
	}

	/** Checking if param's type is a type variable
	  * because of overriding.
	  */
	eq ParameterDeclaration.rewriteCheck() {
		TypeDecl typ = type();
		return typ.isTypeVariable() ? false : isFromSource();
	}

	eq VariableArityParameterDeclaration.rewriteCheck() = false;


	syn lazy Set<InfluenceNode> ASTNode.affectedNodes() =
		Collections.emptySet();
	
	/** Returns the set of InfluenceNodes that requires
	  * updating, if this node is updated
	  */
	eq TypeDecl.affectedNodes() {
		Set<InfluenceNode> nodes = ASTUtils.createSet();
		// collect affectsNodes appropriate members
		for (int j=0; j < getNumBodyDecl(); j++) {
			BodyDecl b = getBodyDecl(j);
			nodes.addAll(b.affectedNodes());
		}
		return nodes;
	}
	
	syn lazy Set<InfluenceNode> Variable.affectedNodes() {
		Set<InfluenceNode> nodes = ASTUtils.createSet();
		nodes.add(this);
		nodes.addAll(reachableINodes());
		nodes.addAll(super.affectedNodes());
		return nodes;
	}


	syn lazy Set<InfluenceNode> MethodDecl.affectedNodes() {
		Set<InfluenceNode> nodes = ASTUtils.createSet();
		nodes.add(this);
		nodes.addAll(reachableINodes());
		nodes.addAll(super.affectedNodes());
		for(ParameterDeclaration param : getParameterList()) {
			nodes.addAll(param.affectedNodes());
		}
		return nodes;
	}

	public void ASTNode.writeToWildcards() { }

	public void InfluenceNode.writeToWildcards() {
		Access type = getTypeAccess();
		String oldAccess = type.toString();
		String newAccess = ASTNode.analysisStrategy.wildString(type);
		type.writeWildcardReplaceInfo(oldAccess, newAccess);
	}

	// Methods for testing
	public void ASTNode.logRewritability() {
    for(int i = 0; i < getNumChild(); i++) {
    	getChild(i).logRewritability();
    }
	}

	public void InfluenceNode.logRewritability() {
		String name = fullName();
		if(isUseful()) {
			System.out.printf("isRewritable(%s): %b", name, isRewritable());
			System.out.println();
			logFlowsTo();
		}
		else {
			System.out.println("skipping rewritability logging for " + name);
		}
    super.logRewritability();
	}
}
