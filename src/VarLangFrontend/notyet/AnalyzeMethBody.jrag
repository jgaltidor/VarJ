import java.util.ArrayList;
import java.util.Collections;
import java.util.Set;
import java.util.HashSet;

aspect AnalyzeMethBody
{
	public class MethBodyAnalysis extends AnalysisStrategy
	{
		public MethBodyAnalysis(Visibility visibility) { super(visibility); }

		public java.util.List<VExpr> varBounds(TypeContainer container, TypeVariable tv) {
			return container.varBoundsBodies(tv);
		}
	}

	syn lazy java.util.List<VExpr> TypeContainer.varBoundsBodies(TypeVariable tv);

	// TypeDecl.varBoundsBodies
	
	eq TypeDecl.varBoundsBodies(TypeVariable tv) = varBoundsSig(tv);

	// BodyDecl.varBoundsBodies

	eq BodyDecl.varBoundsBodies(TypeVariable tv) = varBoundsSig(tv);

	eq MethodDecl.varBoundsBodies(TypeVariable tv) {
		java.util.List<VExpr> bounds = new ArrayList<VExpr>();
		String fullname = fullName();
		VExpr bound;
		
		// Collect bounds from argument types, which will now contain unknowns
		// denoting of the most general use-site variance annotations allowed
		// for method bodies.
		for (int i = 0; i < getNumParameter(); i++) {
			ParameterDeclaration param = getParameter(i);
			if(param.type().structurallyContains(tv)) {
				VExpr paramTypeVar = param.varExprWithUVars(tv);
				bound = new Transform(CONTRAVARIANT, paramTypeVar);
				LOG.log(INFO, String.format("varBoundsBodies(%s [arg %d]): %s",
					fullname, i, bound));
				bounds.add(bound);
			}
		}
		
		bounds.addAll(boundsFromReturnType());
		return bounds;
	}
	
	
	syn VExpr ParameterDeclaration.varExprWithUVars(TypeVariable tv) {
		TypeDecl typ = type();
		if(!typ.isParameterizedType()) {
			return typ.varExpr(tv);
		}
		GenericTypeDecl gtd = (GenericTypeDecl) typ.original();
		ParTypeDecl ptyp = (ParTypeDecl) typ;
		VExpr result = null;
		for (int i = 0; i < ptyp.getNumArgument(); i++) {
			TypeDecl typeArg = ptyp.getArgument(i).type();
			if(typeArg.structurallyContains(tv)) {
				DVar gtdVar = gtd.getDVar(i);
				Value specifiedAnnotation;
				if (typeArg.isWildcardExtendsType())
					specifiedAnnotation = COVARIANT;
				else if (typeArg.isWildcardSuperType())
					specifiedAnnotation = CONTRAVARIANT;
				else
					specifiedAnnotation = INVARIANT;
				UVar optimalAnnotation = getUVar(i);
				VExpr newVar = new Transform(
					new Join(gtdVar, new Join(specifiedAnnotation, optimalAnnotation)),
					typeArg.varExpr(tv));
				result = (result == null) ?
					newVar : new Meet(result, newVar);
			}
		}
		return (result == null) ? BIVARIANT : result;
	}


	eq GenericMethodDecl.varBoundsBodies(TypeVariable tv) {
		java.util.List<VExpr> bounds = new ArrayList<VExpr>();
		bounds.addAll(super.varBoundsBodies(tv));
		String fullname = fullName();
		
		// Collect bounds from upper bounds of type parameters.
		// Java does not allow lower bounds on type parameters.
		// Upper bounds of method type parameters are in
		// contravariant positions.
		for(int j = 0; j < getNumTypeParameter(); j++) {
			TypeVariable param = getTypeParameter(j);
			for (int i = 0; i < param.getNumTypeBound(); i++) {
				TypeDecl typ = param.getTypeBound(i).type();
				if(typ.structurallyContains(tv)) {
					VExpr bound = new Transform(CONTRAVARIANT, typ.varExpr(tv));
					LOG.log(INFO, String.format(
						"varBoundsBodies(%s [type arg bound (%d, %d)]): %s",
						fullname, j, i, bound));
					bounds.add(bound);
				}
			}
		}
		return bounds;
	}

	eq UVar.bounds() = getParam().usesiteListOfBoundLists().get(getIndex());


	syn lazy java.util.List<VExpr> ParameterDeclaration.usesiteBoundList(int index)
		= usesiteListOfBoundLists().get(index);
	
	syn lazy java.util.List<java.util.List<VExpr>> ParameterDeclaration.usesiteListOfBoundLists()
	{
		TypeDecl typ = var.type();
		if(!typ.isParameterizedType()) {
			return Collections.emptyList();
		}
		GenericTypeDecl gtd = (GenericTypeDecl) typ.original();
		int numTypeParams = gtd.getNumTypeParameter();
		if(numTypeParams == 0) {
			return Collections.emptyList();
		}
		ArrayList<java.util.List<VExpr>> listOfBoundLists =
			new ArrayList<java.util.List<VExpr>>(numTypeParams);

		// overridingParameters is used to add bounds induced by
		// all overriding method implementations
		java.util.List<ParameterDeclaration> overridingParameters = overridingParams();

		for(int i = 0; i < numTypeParams; i++) {
			TypeVariable tv = gtd.getTypeParameter(i);
			// that may not be too conservative
			ArrayList<VExpr> bounds = new ArrayList<VExpr>();
			if(getAssignedTo().empty()) {
				// Add bounds induced by all overriding method implementations.
				for(ParameterDeclaration param : overridingParameters) {
					// each enclosingBody should be a method
					BodyDecl enclosingBody = param.enclosingBodyDecl();
					bounds.addAll(enclosingBody.usesiteBounds(param, tv));
				}
			}
			else {
				bounds.add();
			}
			listOfBoundLists.add(bounds);
		}
		return listOfBoundLists;
	}

	/** Returns the set of bounds placed on the def-site variance of tv
	  * required to support the uses of var in the ASTNode.
	  * This method is used to compute the bounds on use-site variance
	  * annotations.
	  */
	syn java.util.List<VExpr> ASTNode.usesiteBounds(Variable var, TypeVariable tv) {
		ArrayList<VExpr> bounds = new ArrayList<VExpr>();
    for(int i = 0; i < getNumChild(); i++) {
    	bounds.addAll(getChild(i).usesiteBounds(var, tv));
    }
    return bounds;
	}

	eq MethodAccess.usesiteBounds(Variable var, TypeVariable tv) {
		ArrayList<VExpr> bounds = new ArrayList<VExpr>();
		bounds.addAll(super.usesiteBounds(var, tv));
		if(qualifiedBy(var)) {
			MethodDecl method = decl().originalDecl();
			if(!method.isStatic()) {
				bounds.addAll(strategy.varBounds(method, tv))
			}
		}
		return bounds;
	}

	eq VarAccess.usesiteBounds(Variable var, TypeVariable tv) {
		ArrayList<VExpr> bounds = new ArrayList<VExpr>();
		if(qualifiedBy(var)) {
			Variable vdecl = decl();
			if(vdecl.isInstanceVariable()) {
				FieldDeclaration field = ((FieldDeclaration) vdecl).originalDecl();
				TypeDecl fieldType = var.type();
				if(fieldType.structurallyContains(tv)) {
					VExpr vexpr = fieldType.varExpr(tv);
					if(isWriteTarget()) {
						// field is being written to so need the
						// "contravariant version"
						bounds.add(new Transform(CONTRAVARIANT, vexpr));
					}
					else {
						// field is being read from so need the
						// "covariant version"
						bounds.add(vexpr);
					}
				}
			}
		}
		return bounds;
	}

	syn lazy boolean Expr.qualifiedBy(Variable v) = false;

	eq VarAccess.qualifiedBy(Variable v) {
		if (decl() == v) return true;
		else if (isQualified()) return qualifier().qualifiedBy(v);
		else return false;
	}


	/**
	 * An access is considered a src of assignment if it is assigned
	 * directly to a variable -- this includes method calls using
	 * access as a parameter.
	 **/
	inh lazy boolean Expr.isAssignSrc(Access v);

	eq AssignExpr.getSource().isAssignSrc(Access v) =
		(getSource() instanceof Access) && ((Access) getSource()).lastAccess() == v;
	
	eq VariableDeclaration.getInit().isAssignSrc(Access v) =
		(getInit() instanceof Access) && ((Access) getInit()).lastAccess() == v;

	eq MethodAccess.getArg(int i).isAssignSrc(Access v) =
		(getArg(i) instanceof Access) && ((Access) getArg(i)).lastAccess() == v;

	eq Program.getChild().isAssignSrc(Access v) = false;


	inh lazy boolean VarAccess.isWriteTarget();

	// if access is on the written end of an assign, then it is not being read
	eq AssignExpr.getDest().isWriteTarget() = true;
	// all other cases, it is read.
	eq Program.getChild().isWriteTarget() = false;

}
