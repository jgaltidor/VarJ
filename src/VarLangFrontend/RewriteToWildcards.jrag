import tame.Util.*;

aspect RewriteToWildcards
{
	syn ASTNode ASTNode.toWild() {
		ASTNode res = (ASTNode) copy();
		for(int i = 0; i < getNumChildNoTransform(); i++) {
			ASTNode node = getChildNoTransform(i);
			if(node != null) node = node.toWild();
				res.setChild(node, i);
		}
		return res;
	}

	eq ClassDecl.toWild() {
		Opt<Access> newSuperClassAccessOpt =
			Util.toWildAccessOpt(this, getSuperClassAccessOpt());
		List<Access> implementsList = 
			Util.toWildAccessList(this, getImplementsList());
		List<BodyDecl> bodyDeclList =
			Util.toWildList(getBodyDeclList());
		return new ClassDecl(getModifiers(), getID(), newSuperClassAccessOpt,
			implementsList, bodyDeclList);
	}
	
	eq GenericClassDecl.toWild() {
		Opt<Access> newSuperClassAccessOpt =
			Util.toWildAccessOpt(this, getSuperClassAccessOpt());
		List<Access> implementsList = 
			Util.toWildAccessList(this, getImplementsList());
		List<BodyDecl> bodyDeclList =
			Util.toWildList(getBodyDeclList());
		return new GenericClassDecl(getModifiers(), getID(), newSuperClassAccessOpt,
			implementsList, bodyDeclList, getTypeParameterList());
	}

	eq InterfaceDecl.toWild() {
		List<Access> superInterfaceList =
			Util.toWildAccessList(this, getSuperInterfaceIdList());
		List<BodyDecl> bodyDeclList =
			Util.toWildList(getBodyDeclList());
		return new InterfaceDecl(getModifiers(), getID(), superInterfaceList, bodyDeclList);
	}

	eq GenericInterfaceDecl.toWild() {
		List<Access> superInterfaceList =
			Util.toWildAccessList(this, getSuperInterfaceIdList());
		List<BodyDecl> bodyDeclList =
			Util.toWildList(getBodyDeclList());
		return new GenericInterfaceDecl(getModifiers(), getID(), superInterfaceList,
			bodyDeclList, getTypeParameterList());
	}

	eq ParameterDeclaration.toWild() =
		new ParameterDeclaration(getModifiers(),
			getTypeAccess().toWildAccess(),
			getID());
	
	eq VariableDeclaration.toWild() =
		new VariableDeclaration(getModifiers(),
			getTypeAccess().toWildAccess(),
			getID(),
			getInitOpt());

	eq FieldDeclaration.toWild() =
		new FieldDeclaration(getModifiers(),
			getTypeAccess().toWildAccess(),
			getID(),
			getInitOpt());

	eq MethodDecl.toWild() {
		Access retType = toWildAccess(getTypeAccess());
		List<ParameterDeclaration> parameterList = Util.toWildList(getParameterList());
		List<Access> exceptionList = Util.toWildAccessList(this, getExceptionList());
		return new MethodDecl(getModifiers(), retType, getID(),
			parameterList, exceptionList, getBlockOpt());
	}
	
	// some optimization
	// instead of copying, just return this
	eq Access.toWild() = this;


	// add toWild method to GenericTypeDecl interface
	syn ASTNode GenericTypeDecl.toWild();


	// Indirect method for logging rewrites
	
	syn Access ASTNode.toWildAccess(Access oldAccess) = oldAccess.toWildAccess();
	
	eq ReferenceType.toWildAccess(Access oldAccess) {
		Access newAccess = super.toWildAccess(oldAccess);
		if(!newAccess.toString().equals(oldAccess.toString())) {
			LOG.log(INFO, String.format(
				"Wildcard Rewrite in %s from %s to %s",
				fullName(), oldAccess, newAccess));
		}
		return newAccess;
	}
	
	eq FieldDeclaration.toWildAccess(Access oldAccess) {
		Access newAccess = super.toWildAccess(oldAccess);
		if(!newAccess.toString().equals(oldAccess.toString())) {
			LOG.log(INFO, String.format(
				"Wildcard Rewrite in %s from %s to %s",
				fullName(), oldAccess, newAccess));
		}
		return newAccess;
	}
	
	eq MethodDecl.toWildAccess(Access oldAccess) {
		Access newAccess = super.toWildAccess(oldAccess);
		if(!newAccess.toString().equals(oldAccess.toString())) {
			LOG.log(INFO, String.format(
				"Wildcard Rewrite in %s from %s to %s",
				fullName(), oldAccess, newAccess));
		}
		return newAccess;
	}
	
	eq ParameterDeclaration.toWildAccess(Access oldAccess)
		= getParent().toWildAccess(oldAccess);
	
	eq VariableDeclaration.toWildAccess(Access oldAccess)
		= getParent().toWildAccess(oldAccess);


	// Finally, the toWildAccess logic

	syn Access Access.toWildAccess() = this;
	
	eq ParTypeAccess.toWildAccess() {
		if(!(genericDecl() instanceof GenericTypeDecl)) {
			return super.toWildAccess();
		}
		GenericTypeDecl gtd = (GenericTypeDecl) genericDecl();
		List<Access> typeArguments = new List<Access>();
		for(int i = 0; i < getNumTypeArgument(); i++) {
			// first rewrite old access
			Access oldAccess = getTypeArgument(i).toWildAccess();
			Value defSiteVariance = gtd.computeVar(i);
			// Determine use-site variance annotation
			Value useSiteVariance;
			if(oldAccess instanceof WildcardSuper)
				useSiteVariance = CONTRAVARIANT;
			else if(oldAccess instanceof WildcardExtends)
				useSiteVariance = COVARIANT;
			else if(oldAccess instanceof Wildcard)
				useSiteVariance = BIVARIANT;
			else
				useSiteVariance = INVARIANT;
			Access newAccess;
			if(defSiteVariance.gt(useSiteVariance)) {
				// then rewrite
				if(defSiteVariance.equals(COVARIANT))
					newAccess = new WildcardExtends(oldAccess);
				else if(defSiteVariance.equals(CONTRAVARIANT))
					newAccess = new WildcardSuper(oldAccess);
				else // defSiteVariance must equal BIVARIANT
					newAccess = new Wildcard();
			}
			else {
				newAccess = oldAccess;
			}
			typeArguments.add(newAccess);
		}
		return new ParTypeAccess(getTypeAccess(), typeArguments);
	}

	eq WildcardExtends.toWildAccess() = new WildcardExtends(getAccess().toWildAccess());
	
	eq WildcardSuper.toWildAccess() = new WildcardSuper(getAccess().toWildAccess());
}
