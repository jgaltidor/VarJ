import java.util.ArrayList;
import java.util.Collections;
import java.util.Set;
import java.util.HashSet;

aspect ConstraintGenerator
{
	syn lazy DVar GenericTypeDecl.getDVar(int index) =
		getDVar(getTypeParameter(index));

	syn lazy DVar GenericTypeDecl.getDVar(TypeVariable tv) =
		new DVar(this, tv);

	syn lazy java.util.List<VExpr> DVar.bounds() =
		getGenericTypeDecl().varBounds(getTypeVariable());

	// varBounds
	
	syn lazy java.util.List<VExpr> GenericTypeDecl.varBounds(TypeVariable tv);
	
	
	syn lazy java.util.List<VExpr> TypeDecl.varBounds(TypeVariable tv) = Collections.emptyList();
	
	eq ClassDecl.varBounds(TypeVariable tv)
	{
		java.util.List<VExpr> bounds = new ArrayList<VExpr>();
		String fullname = fullName();
		VExpr bound;
		// analyze super type declarations
		int n = 0;
		for (TypeDecl st : superTypes() ) {
			if(st.structurallyContains(tv)) {
				bound = st.varExpr(tv);
				LOG.log(INFO, String.format(
					"varBounds(%s [super type %d]): %s", fullname, n++, bound));
				bounds.add(bound);
			}
		}

		LOG.log(INFO, fullname + ".checkPrivateMembers: " + checkPrivateMembers());
		
		// analyze type signatures of appropriate members
		for (int j=0; j < getNumBodyDecl(); j++) {
			BodyDecl b = getBodyDecl(j);
			if(b.isFieldDeclaration()) {
				FieldDeclaration f = (FieldDeclaration) b;
				if((!f.isPrivate() || checkPrivateMembers()) && !f.isStatic())
					bounds.addAll(f.varBounds(tv));
			}
			else if(b.isMethodDecl()) {
				MethodDecl m = (MethodDecl) b;
				if((!m.isPrivate() || checkPrivateMembers()) && !m.isStatic())
					bounds.addAll(m.varBounds(tv));
			}
			else
				bounds.addAll(b.varBounds(tv));
		}
		return bounds;
	}


	eq InterfaceDecl.varBounds(TypeVariable tv)
	{
		java.util.List<VExpr> bounds = new ArrayList<VExpr>();
		String fullname = fullName();
		VExpr bound;
		// analyze super type declarations
		int n = 0;
		for (TypeDecl st : superTypes() ) {
			if(st.structurallyContains(tv)) {
				bound = st.varExpr(tv);
				LOG.log(INFO, String.format(
					"varBounds(%s [super type %d]): %s", fullname, n++, bound));
				bounds.add(bound);
			}
		}

		LOG.log(INFO, fullname + ".checkPrivateMembers: " + checkPrivateMembers());
		
		// analyze type signatures of appropriate members
		for (int j=0; j < getNumBodyDecl(); j++) {
			BodyDecl b = getBodyDecl(j);
			if(b.isFieldDeclaration()) {
				FieldDeclaration f = (FieldDeclaration) b;
				if((!f.isPrivate() || checkPrivateMembers()) && !f.isStatic())
					bounds.addAll(f.varBounds(tv));
			}
			else if(b.isMethodDecl()) {
				MethodDecl m = (MethodDecl) b;
				if((!m.isPrivate() || checkPrivateMembers()) && !m.isStatic())
					bounds.addAll(m.varBounds(tv));
			}
			else
				bounds.addAll(b.varBounds(tv));
		}
		return bounds;
	}


	eq GenericTypeDecl.varBounds(TypeVariable tv)
	{
		java.util.List<VExpr> bounds = super.varBounds(tv);
		String fullname = fullName();
		VExpr bound;

		// Collect bounds from upper bounds of type parameters.
		// Java does not allow lower bounds on type parameters.
		// Upper bounds of class type parameters are in
		// covariant positions.
		for(int j = 0; j < getNumTypeParameter(); j++) {
			TypeVariable param = getTypeParameter(j);
			for (int i = 0; i < param.getNumTypeBound(); i++) {
				TypeDecl typ = param.getTypeBound(i).type();
				if(typ.structurallyContains(tv)) {
					bound = typ.varExpr(tv);
					LOG.log(INFO, String.format(
						"varBounds(%s [type arg bound (%d, %d)]): %s",
						fullname, j, i, bound));
					bounds.add(bound);
				}
			}
		}
		return bounds;
	}


	syn lazy java.util.List<VExpr> BodyDecl.varBounds(TypeVariable tv)
		 = Collections.emptyList();


	eq FieldDeclaration.varBounds(TypeVariable tv)
	{
		java.util.List<VExpr> bounds = new ArrayList<VExpr>();
		String fullname = fullName();

		// field type
		TypeDecl t = type();
		if(!t.structurallyContains(tv))
			return bounds;

		// variance of tv in return type t
		VExpr vart = t.varExpr(tv);
		// Fields can be read, so t is in a covariant position
		VExpr bound = vart;
		bounds.add(bound);
		
		LOG.log(INFO, String.format("varBounds(%s): %s", fullname, bound));

		// If field is not final, then t is also in a contravariant position
		if(!isFinal()) {
			bound = new Transform(CONTRAVARIANT, vart);
			LOG.log(INFO, String.format("varBounds(%s): %s", fullname, bound));
			bounds.add(bound);
		}
		return bounds;
	}


	eq MethodDecl.varBounds(TypeVariable tv)
	{
		java.util.List<VExpr> bounds = new ArrayList<VExpr>();
		String fullname = fullName();
		VExpr bound;
		// bound from return type
		TypeDecl rtyp = type();
		if(rtyp.structurallyContains(tv)) {
			bound = new Transform(COVARIANT, rtyp.varExpr(tv));
			LOG.log(INFO, String.format("varBounds(%s [return]): %s",
				fullname, bound));
			bounds.add(bound);
		}
		
		// bounds from formal value argument types
		// argument types are in contravariant positions
		for (int i = 0; i < getNumParameter(); i++) {
			TypeDecl atyp = getParameter(i).type();
			if(atyp.structurallyContains(tv)) {
				bound = new Transform(CONTRAVARIANT, atyp.varExpr(tv));
				LOG.log(INFO, String.format("varBounds(%s [arg %d]): %s",
					fullname, i, bound));
				bounds.add(bound);
			}
		}
		return bounds;
	}
	
	eq GenericMethodDecl.varBounds(TypeVariable tv)
	{
		// Collect bounds from return and argument types
		java.util.List<VExpr> bounds = super.varBounds(tv);
		String fullname = fullName();

		// Collect bounds from upper bounds of type parameters.
		// Java does not allow lower bounds on type parameters.
		// Upper bounds of method type parameters are in
		// contravariant positions.
		for(int j = 0; j < getNumTypeParameter(); j++) {
			TypeVariable param = getTypeParameter(j);
			for (int i = 0; i < param.getNumTypeBound(); i++) {
				TypeDecl typ = param.getTypeBound(i).type();
				if(typ.structurallyContains(tv)) {
					VExpr bound = new Transform(CONTRAVARIANT, typ.varExpr(tv));
					LOG.log(INFO, String.format(
						"varBounds(%s [type arg bound (%d, %d)]): %s",
						fullname, j, i, bound));
					bounds.add(bound);
				}
			}
		}
		return bounds;
	}

	// varExpr
	
	syn lazy VExpr TypeDecl.varExpr(TypeVariable tv) = BIVARIANT;
	
	/**
	 * var(X; C<T_1, ..., T_n>)
	 */
	eq ParTypeDecl.varExpr(TypeVariable tv) {
		GenericTypeDecl gtd = (GenericTypeDecl) genericDecl();
		VExpr result = null;
		for (int i = 0; i < getNumArgument(); i++) {
			TypeDecl typeArg = getArgument(i).type();
			if(typeArg.structurallyContains(tv)) {
				DVar gtdVar = gtd.getDVar(i);
				VExpr annotationVar;
				if (typeArg.isWildcardExtendsType())
					annotationVar = COVARIANT;
				else if (typeArg.isWildcardSuperType())
					annotationVar = CONTRAVARIANT;
				else
					annotationVar = INVARIANT;
				VExpr newVar = new Transform(
					new Join(gtdVar, annotationVar),
					typeArg.varExpr(tv));
				result = (result == null) ?
					newVar : new Meet(result, newVar);
			}
		}
		return (result == null) ? BIVARIANT : result;
	}

	eq TypeVariable.varExpr(TypeVariable tv) =
		(this == tv) ? COVARIANT : BIVARIANT;

	eq ArrayDecl.varExpr(TypeVariable tv) =
		componentType().varExpr(tv);

	eq WildcardExtendsType.varExpr(TypeVariable tv) =
		getAccess().type().varExpr(tv);

	eq WildcardSuperType.varExpr(TypeVariable tv) =
		getAccess().type().varExpr(tv);


	
	// dvarBoundClosure
	syn lazy Set<DVar> GenericTypeDecl.dvarBoundClosure(int index) =
		dvarBoundClosure(getTypeParameter(index));

	syn lazy Set<DVar> GenericTypeDecl.dvarBoundClosure(TypeVariable tv) =
		getDVar(tv).dvarBoundClosure();

	syn lazy Set<DVar> DVar.dvarBoundClosure() circular [Collections.emptySet()]
	{
		Set<DVar> dvars = new HashSet<DVar>();
		for(VExpr bound : this.bounds()) {
			for(DVar dvar : bound.getDVars()) {
				dvars.add(dvar);
				if(!dvar.equals(this))
					dvars.addAll(dvar.dvarBoundClosure());
			}
		}
		return dvars;
	}
	
	syn lazy boolean DVar.isRecursivelyBounded()
		= dvarBoundClosure().contains(this);
	

	/** Returns the set of DVars in a variance expression. */
	syn Set<DVar> VExpr.getDVars() = Collections.emptySet();
	
	eq Transform.getDVars() {
		Set<DVar> set = new HashSet<DVar>();
		set.addAll(getLeft().getDVars());
		set.addAll(getRight().getDVars());
		return set;
	}

	eq Meet.getDVars() {
		Set<DVar> set = new HashSet<DVar>();
		set.addAll(getLeft().getDVars());
		set.addAll(getRight().getDVars());
		return set;
	}

	eq Join.getDVars() {
		Set<DVar> set = new HashSet<DVar>();
		set.addAll(getLeft().getDVars());
		set.addAll(getRight().getDVars());
		return set;
	}
	
	eq DVar.getDVars() {
		Set<DVar> set = new HashSet<DVar>();
		set.add(this);
		return set;
	}


	// Avoid having to use more time expensive instanceof operation
	syn lazy boolean TypeDecl.isWildcardExtendsType() = false;
	eq WildcardExtendsType.isWildcardExtendsType() = true;

	syn lazy boolean TypeDecl.isWildcardSuperType() = false;
	eq WildcardSuperType.isWildcardSuperType() = true;

	syn boolean TypeDecl.isWildcardType() = false;
	eq WildcardType.isWildcardType() = true;

	syn lazy boolean BodyDecl.isFieldDeclaration() = false;
	eq FieldDeclaration.isFieldDeclaration() = true;

	syn lazy boolean BodyDecl.isMethodDecl() = false;
	eq MethodDecl.isMethodDecl() = true;
	
	
	/** Full name of field */
	syn lazy String FieldDeclaration.fullName() =
		hostType().fullName() + '.' + name();

	/** Full name of method */
	syn lazy String MethodDecl.fullName() =
		hostType().fullName() + '.' + name();


	/** If any of the argument types contain this type in its closure,
	  * then return false.
	  * Otherwise, return true
	  */
	syn lazy boolean TypeDecl.analyzePrivateMembers() {
		for (int j=0; j < getNumBodyDecl(); j++) {
			BodyDecl b = getBodyDecl(j);
			if(b.isMethodDecl()) {
				MethodDecl meth = (MethodDecl) b;
				if(!meth.isStatic()) {
					for (int i=0; i < meth.getNumParameter(); i++) {
						if(meth.getParameter(i).type().isInTypeClosure(this))
							return true;
					}
				}
			}
		}
		return false;
	}

	/** Determine whether or not to check private members */
	syn lazy boolean TypeDecl.checkPrivateMembers() =
		analyzePrivate || analyzePrivateMembers();
}


